{
  "name": "@budnet/ui",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "react-native": "./src/native/index.ts",
      "default": "./src/web/index.ts"
    },
    "./avatar": {
      "react-native": "./src/native/Avatar.tsx",
      "default": "./src/web/Avatar.tsx"
    },
    "./button": {
      "react-native": "./src/native/Button.tsx",
      "default": "./src/web/Button.tsx"
    },
    "./message": {
      "react-native": "./src/native/Message.tsx",
      "default": "./src/web/Message.tsx"
    }
  },
  "dependencies": {
    "@budnet/types": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "react": "^18.2.0",
    "react-native": "^0.76.0",
    "typescript": "^5.4.0",
    "tailwindcss": "^3.4.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
