{
  "name": "budnet",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@budnet/web",
    "dev:desktop": "turbo run dev --filter=@budnet/desktop",
    "dev:mobile": "turbo run dev --filter=@budnet/mobile",
    "dev:server": "turbo run dev --filter=@budnet/server",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:push": "turbo run db:push --filter=@budnet/server",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
